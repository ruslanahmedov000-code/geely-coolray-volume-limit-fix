#!/system/bin/sh
# Usage: ramauto-volume            - show current level
#        ramauto-volume <0..15>    - set boost in dB (0 = off), applied within 5 s
#        ramauto-volume off        - same as 0
CONF=/data/adb/ramauto_volume/gain_db
if [ "$(id -u)" != "0" ]; then echo "run as root: su -c ramauto-volume $*"; exit 1; fi
mkdir -p /data/adb/ramauto_volume
case "$1" in
  "") echo "boost: +$(cat $CONF 2>/dev/null || echo 0) dB"; tail -n 3 /data/adb/ramauto_volume/keeper.log 2>/dev/null ;;
  off) echo 0 > $CONF; echo "boost off" ;;
  *[!0-9]*) echo "need a number 0..15"; exit 1 ;;
  *) V=$1; [ "$V" -gt 15 ] && V=15; echo $V > $CONF; echo "boost set to +$V dB" ;;
esac
